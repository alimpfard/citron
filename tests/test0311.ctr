var ctx is CInterpreter new.
ctx compile: 'extern void qsort(void* base, unsigned long n, unsigned long sz, void* cmp);'.
var sorted is ctx run: '
int cmp(void* a, void* b) { return *(int*)a - *(int*)b; }
int main() {
    int a[6];
    a[0] = 5; a[1] = 3; a[2] = 8; a[3] = 1; a[4] = 9; a[5] = 2;
    qsort(a, 6, 4, cmp);
    int ok = 1, i = 0;
    while (i < 5) { if (a[i] > a[i + 1]) ok = 0; i = i + 1; }
    return ok;
}' arguments: [].
(sorted = 1) ifTrue: { Pen writeln: 'sorted'. } ifFalse: { Pen writeln: 'unsorted'. }.
